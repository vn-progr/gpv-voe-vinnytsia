name: 🧪 Test Render All PNG Images

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  render_test_images:
    name: Generate Test PNGs
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install matplotlib numpy requests beautifulsoup4

      - name: Render Test PNGs to Temporary Directory
        run: |
          set -e
          JSON_FILE="data/Vinnytsiaoblenerho.json"
          # Тимчасова папка для тесту — бойові хеші в images/Vinnytsiaoblenerho не зачіпаються!
          TEST_DIR="images/test"
          TARGET_DIR="images/Vinnytsiaoblenerho"
          
          mkdir -p "$TEST_DIR"
          
          echo "🎨 1/3 Rendering 12 per-queue test charts..."
          python scripts/render_png.py --json "$JSON_FILE" --out "$TEST_DIR" --force
          
          echo "🎨 2/3 Rendering TODAY test overview..."
          python scripts/render_png_all_today.py --json "$JSON_FILE" --out "$TEST_DIR" --force
          
          echo "🎨 3/3 Rendering TOMORROW test overview..."
          python scripts/render_png_all_tomorrow.py --json "$JSON_FILE" --out "$TEST_DIR" --force
          
          echo "🚚 Replacing target PNGs without touching target hash cache..."
          # Копіюємо тільки згенеровані PNG у робочу папку, НЕ зачіпаючи images/Vinnytsiaoblenerho/hash
          cp $TEST_DIR/*.png $TARGET_DIR/ 2>/dev/null || true
          
          # Очищаємо тимчасову папку
          rm -rf "$TEST_DIR"
          
          echo "✅ Test PNGs successfully generated and applied!"

      - name: Commit and Push Updated Images
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          git add images/Vinnytsiaoblenerho/*.png
          
          if git diff-index --quiet HEAD; then
            echo "No image changes detected to commit."
          else
            git commit -m "🧪 Test render: updated all PNG schedule images"
            git pull --rebase origin main
            git push origin main
            echo "Successfully updated test PNGs!"
          fi
